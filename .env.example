# WPS Office KR - Environment Variables Template
# Copy this file to .env and fill in your values
# NEVER commit .env to git!

# GitHub Personal Access Token (for pushing PKGBUILD updates)
# Create at: https://github.com/settings/tokens
# Required scopes: repo, workflow, write:packages
GITHUB_TOKEN=ghp_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# KOSIS API Key (if integrating with KOSIS MCP)
# Get from: https://kosis.kr/openapi/
KOSIS_API_KEY=your_kosis_api_key_here

# Optional: Slack/Discord webhook for notifications
SLACK_WEBHOOK_URL=https://hooks.slack.com/services/xxx/xxx/xxx
DISCORD_WEBHOOK_URL=https://discord.com/api/webhooks/xxx/xxx

# Optional: GPG signing key for package signing
GPG_PRIVATE_KEY=-----BEGIN PGP PRIVATE KEY BLOCK-----
...
-----END PGP PRIVATE KEY BLOCK-----
GPG_PASSPHRASE=your_gpg_passphrase
GPG_KEY_ID=YOUR_KEY_ID